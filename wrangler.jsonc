{
  "name": "portugal",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/photos.json"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "scrapbook-photos"
    }
  ]
}
